PORT=3000
NODE_ENV=development
# Origen del portal permitido por CORS (separar con comas si hay varios)
CORS_ORIGIN=http://localhost:5173
# Vacío: almacenamiento en memoria. Con URL: PostgreSQL.
DATABASE_URL=
# local: la API emite tokens (demo). oidc: valida tokens de Keycloak.
AUTH_MODE=local
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_TTL=1h
# Solo con AUTH_MODE=oidc. Ejemplo: https://keycloak.ejemplo.pa/realms/planillas
OIDC_ISSUER=
OIDC_AUDIENCE=
MAX_FILE_MB=5
LOG_LEVEL=info
