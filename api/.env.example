PORT=3000
NODE_ENV=development
# Origen del portal permitido por CORS (separar con comas si hay varios)
CORS_ORIGIN=http://localhost:5173
# Vacío: almacenamiento en memoria. Con URL: PostgreSQL.
DATABASE_URL=
# local: la API emite tokens (demo). oidc: valida tokens de Keycloak.
AUTH_MODE=local
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_TTL=1h
DEMO_PASSWORD=demo1234
# Solo con AUTH_MODE=oidc. Ejemplo: https://keycloak.ejemplo.pa/realms/planillas
OIDC_ISSUER=
OIDC_AUDIENCE=
MAX_FILE_MB=5
LOG_LEVEL=info
# HU-14: reglas de validación desactivadas (ids separados por comas). Vacío: todas activas.
# Ids: cedula, nombre, salario, dias_laborados, codigo_ocupacion
REGLAS_DESACTIVADAS=
# HU-17: monitoreo. Vacío: GET /metricas deshabilitado.
METRICS_TOKEN=
# Umbrales de alerta sobre los últimos 5 minutos. El webhook (Slack/Discord) es opcional.
ALERTA_TASA_ERROR=0.05
ALERTA_LATENCIA_MS=2000
ALERTA_MIN_SOLICITUDES=20
ALERTA_WEBHOOK_URL=
